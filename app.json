{
  "expo": {
    "name": "lockin-app",
    "slug": "lockin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockinapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.chamuditha04.lockinapp",
      "icon": "./assets/expo.icon",
      "deploymentTarget": "26.0",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "LockIn needs alarm access to wake you up at the scheduled time and display the reading task.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.chamuditha04.lockinapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_FULL_SCREEN_INTENT",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.chamuditha04.lockinapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ],
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m",
              "reactNativeArchitectures": "arm64-v8a,x86_64"
            }
          },
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset",
      "./plugins/withLockGuard",
      "./plugins/withLockInIOS",
      ["@bacons/apple-targets", {}]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
